# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Trên cloud: đặt các biến này trong dashboard của nền tảng.
# ============================================================

# Cổng app lắng nghe (Railway/Render tự cấp biến PORT)
PORT=8000

# development | staging | production
ENVIRONMENT=development

# API key client phải gửi qua header X-API-Key. Đổi thành chuỗi ngẫu nhiên dài khi deploy.
AGENT_API_KEY=change-me

# Redis dùng cho rate limit và cost guard.
# Chạy local bằng docker compose thì host là "redis": redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Số request tối đa / 60 giây cho mỗi API key (vượt → 429)
RATE_LIMIT_PER_MINUTE=10

# Ngân sách tối đa (USD). Vượt → 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=30.0
